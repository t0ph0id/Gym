<?xml version="1.0" encoding="utf-8"?>
<!-- Workout data lives in Firestore; don't copy the local cache or sign-in tokens via cloud backup
     or device-to-device transfer. Signing in on the new phone brings everything back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
