rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only real Google accounts (no anonymous sign-ins).
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMember(pid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/partnerships/$(pid)).data.members;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes: anyone signed in can look one up by its exact code (no listing).
    // Only members of a pair can create or retire its code.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.partnershipId);
      allow delete: if isMember(resource.data.partnershipId);
    }

    match /partnerships/{pid} {
      // Members can read; a not-yet-full pair can be read by someone holding its code.
      allow get: if signedIn()
        && (request.auth.uid in resource.data.members || resource.data.members.size() < 2);

      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        // a member can update (rename, leave)
        request.auth.uid in resource.data.members
        // or a newcomer can add only themself (and their name) to a pair with one person in it,
        // without touching anything else on the pair
        || (resource.data.members.size() == 1
            && request.resource.data.members.size() == 2
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
      );

      // Plans, workouts, sets, last weights: both partners have full access.
      match /{document=**} {
        allow read, write: if isMember(pid);
      }
    }
  }
}
